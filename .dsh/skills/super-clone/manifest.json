{
  "schema": "weeksir-skill-manifest/0.1",
  "id": "super-clone",
  "name": "超级复刻",
  "version": "0.1.0",
  "kind": "片型合同",
  "stage": "produce",
  "description": "超级复刻稳定生产：原片换产品(必选)，可选换脸/换衣服/换背景/换音色；保留 Wan 3.0 与 Seedance 2.5 两条参考视频生成路线，按复杂度切段并多重验收",
  "when_to_use": "超级复刻、爆款复刻、换产品、换脸、换背景；多脸/短镜/对齐原声的难单",
  "visibility": "customer",
  "capabilities": ["video.generate"],
  "engine": "wan3|seedance-2.5",
  "depends_on": ["hypit"],
  "runner": "runner/run.py",
  "entry": "${VIDEO_SKILL_HOME}/backend/services/super_clone_wan3.py:run_pipeline",
  "approval_points": ["timeline", "failed-rerun", "final"],
  "input": {
    "required": ["video", "product_name", "product_images"],
    "optional": ["model_images", "clothing_images", "scene_text", "voice_audio", "engine", "seedance_reference_video", "seedance_reference_images", "trim_start", "trim_end", "product_facts"]
  },
  "credits_estimate": "engine-dependent"
}
