<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Hypit 内置 Agent</title>
<style>
* { margin: 0; padding: 0; box-sizing: border-box; }
:root {
  --bg: #0b0714; --panel: #181226; --border: #2e2448; --border2: #3b2f5c;
  --text: #e8e4f0; --muted: #8b8499; --accent: #8b5cf6; --accent2: #2563eb;
  --ok: #6ee7b7; --warn: #fcd34d; --err: #fca5a5;
  --user-bg: #1e1b4b; --asst-bg: #181226;
}
body { font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; background: var(--bg); color: var(--text); min-height: 100vh; overflow: hidden; }
.topbar { display: flex; align-items: center; justify-content: space-between; padding: 10px 18px; background: linear-gradient(90deg, #4c1d95, #6d28d9 45%, #2563eb); height: 50px; }
.topbar-left { display: flex; align-items: center; gap: 12px; }
.back { color: #fff; text-decoration: none; font-size: .82em; padding: 5px 10px; border: 1px solid rgba(255,255,255,.3); border-radius: 8px; }
.back:hover { background: rgba(255,255,255,.12); }
.topbar h1 { font-size: 1.1em; color: #fff; letter-spacing: 1px; }
.tag { background: rgba(255,255,255,.18); color: #fff; padding: 3px 10px; border-radius: 20px; font-size: .72em; }
.topbar-right { display: flex; gap: 8px; align-items: center; }
.topbar-right .pill { background: rgba(255,255,255,.12); color: #ddd6fe; padding: 4px 10px; border-radius: 999px; font-size: .72em; cursor: pointer; }
.topbar-right .pill:hover { background: rgba(255,255,255,.2); }
.layout { display: grid; grid-template-columns: 320px 1fr 0px; height: calc(100vh - 50px); transition: grid-template-columns .2s ease; }
.layout.show-right { grid-template-columns: 320px 1fr 440px; }
@media (max-width: 1100px) { .layout { grid-template-columns: 1fr; } .layout.show-right { grid-template-columns: 1fr; } }
.sidebar { background: #120c1e; border-right: 1px solid var(--border); padding: 14px; overflow-y: auto; min-height: 0; }
.panel { background: var(--panel); border: 1px solid var(--border); border-radius: 10px; padding: 12px; margin-bottom: 12px; }
.section { font-size: .72em; color: #a78bfa; letter-spacing: .6px; text-transform: uppercase; margin-bottom: 8px; font-weight: 650; }
label { display: block; font-size: .75em; color: var(--muted); margin: 6px 0 4px; }
input, textarea, select { width: 100%; background: #0d0816; border: 1px solid var(--border2); color: #fff; border-radius: 8px; padding: 7px 9px; font: inherit; font-size: .85em; outline: none; }
textarea { min-height: 64px; resize: vertical; line-height: 1.45; }
input:focus, textarea:focus, select:focus { border-color: var(--accent); }
.row { display: flex; gap: 6px; }
.btn { border: 0; border-radius: 8px; padding: 8px 11px; cursor: pointer; font: inherit; font-weight: 600; color: #fff; font-size: .82em; }
.btn:disabled { opacity: .45; cursor: not-allowed; }
.primary { background: linear-gradient(90deg, #7c3aed, #2563eb); flex: 1; }
.ghost { background: #24183a; color: #d8b4fe; border: 1px solid var(--border2); }
.ok-btn { background: linear-gradient(90deg, #15803d, #16a34a); }
.no-btn { background: linear-gradient(90deg, #b91c1c, #dc2626); }
.chip { display: inline-flex; align-items: center; gap: 5px; padding: 3px 9px; border-radius: 999px; font-size: .68em; margin: 0 5px 5px 0; border: 1px solid transparent; }
.chip.ok { background: rgba(16,185,129,.12); border-color: rgba(16,185,129,.35); color: var(--ok); }
.chip.warn { background: rgba(245,158,11,.12); border-color: rgba(245,158,11,.35); color: var(--warn); }
.chip.down { background: rgba(239,68,68,.12); border-color: rgba(239,68,68,.35); color: var(--err); }
.muted { color: var(--muted); font-size: .76em; line-height: 1.5; }
.upload { border: 1.5px dashed var(--border2); border-radius: 8px; padding: 10px; text-align: center; cursor: pointer; margin-bottom: 6px; background: #0d0816; font-size: .78em; }
.upload:hover { border-color: var(--accent); }
.upload input { display: none; }
.item { padding: 7px 9px; border: 1px solid var(--border); border-radius: 8px; margin-bottom: 5px; cursor: pointer; font-size: .8em; }
.item:hover, .item.active { border-color: var(--accent); background: #22183a; }
.item .meta { color: var(--muted); font-size: .72em; margin-top: 2px; }

/* 中间聊天区 */
.chat { display: flex; flex-direction: column; height: 100%; min-height: 0; background: var(--bg); }
.chat-head { padding: 10px 18px; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; gap: 10px; flex-shrink: 0; }
.chat-head .title { font-size: .95em; font-weight: 600; }
.chat-head .sub { color: var(--muted); font-size: .72em; margin-top: 2px; }
.chat-head .actions { display: flex; gap: 6px; }
.chat-head .actions .btn { padding: 6px 9px; font-size: .76em; flex: 0 0 auto; }
.messages { flex: 1; min-height: 0; overflow-y: auto; padding: 18px 24px 8px; display: flex; flex-direction: column; gap: 14px; }
.msg { max-width: 820px; width: 100%; align-self: center; }
.msg.user { align-self: flex-end; max-width: 70%; }
.msg .role { font-size: .68em; color: var(--muted); margin-bottom: 4px; padding: 0 4px; }
.msg .bubble { background: var(--asst-bg); border: 1px solid var(--border); border-radius: 12px; padding: 12px 14px; font-size: .88em; line-height: 1.6; white-space: pre-wrap; word-wrap: break-word; }
.msg.user .bubble { background: var(--user-bg); border-color: #4c1d95; }
.msg .bubble code { background: #2e1064; padding: 1px 5px; border-radius: 4px; font-size: .9em; font-family: ui-monospace, Consolas, monospace; }
.msg .bubble pre { background: #09060f; border: 1px solid var(--border); border-radius: 8px; padding: 10px; margin: 6px 0; overflow-x: auto; }
.msg .bubble pre code { background: transparent; padding: 0; }
.tool-card { border: 1px solid #4c1d95; border-radius: 12px; background: #1a1030; padding: 12px 14px; }
.tool-card .head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; }
.tool-card .name { font-weight: 650; color: #ddd6fe; font-size: .88em; }
.tool-card .badge { background: #4c1d95; color: #fff; padding: 2px 8px; border-radius: 999px; font-size: .65em; }
.tool-card .args { background: #09060f; border: 1px solid var(--border); border-radius: 8px; padding: 8px 10px; font-family: ui-monospace, Consolas, monospace; font-size: .76em; color: #c4b5fd; margin: 6px 0; white-space: pre-wrap; max-height: 200px; overflow-y: auto; }
.tool-card .actions { display: flex; gap: 8px; margin-top: 8px; }
.tool-card.pending { border-color: #f59e0b; box-shadow: 0 0 0 1px rgba(245,158,11,.2); }
.tool-card.approved { border-color: #16a34a; }
.tool-card.rejected { border-color: #dc2626; opacity: .7; }
.tool-card .result { margin-top: 8px; background: #09060f; border: 1px solid var(--border); border-radius: 8px; padding: 8px 10px; font-family: ui-monospace, Consolas, monospace; font-size: .76em; color: #c4b5fd; max-height: 240px; overflow-y: auto; white-space: pre-wrap; }
.tool-card .result.ok { color: var(--ok); border-color: rgba(16,185,129,.4); }
.tool-card .result.err { color: var(--err); border-color: rgba(239,68,68,.4); }
.empty { text-align: center; padding: 40px 20px; color: var(--muted); font-size: .85em; }
.empty .icon { font-size: 2.4em; margin-bottom: 12px; opacity: .5; }
.composer { padding: 12px 24px 14px; border-top: 1px solid var(--border); background: #0a0612; flex-shrink: 0; }
.composer-inner { max-width: 820px; margin: 0 auto; display: flex; gap: 8px; align-items: flex-end; }
.composer textarea { flex: 1; min-height: 48px; max-height: 200px; resize: none; }
.composer .send { padding: 12px 16px; flex: 0 0 auto; }
.composer .hint-row { color: var(--muted); font-size: .7em; margin-top: 4px; max-width: 820px; margin-left: auto; margin-right: auto; }
.streaming-cursor { display: inline-block; width: 6px; height: 14px; background: var(--accent); vertical-align: middle; margin-left: 2px; animation: blink .8s steps(2) infinite; }
@keyframes blink { 50% { opacity: 0; } }

/* 右侧抽屉 */
.right-panel { background: #120c1e; border-left: 1px solid var(--border); overflow-y: auto; padding: 14px; min-height: 0; }
.right-panel .tabs { display: flex; gap: 4px; border-bottom: 1px solid var(--border); margin-bottom: 12px; }
.right-panel .tab { padding: 6px 12px; color: var(--muted); cursor: pointer; font-size: .8em; border-bottom: 2px solid transparent; }
.right-panel .tab.active { color: #fff; border-bottom-color: var(--accent); }
.right-panel .close { float: right; cursor: pointer; color: var(--muted); font-size: .9em; padding: 4px 8px; }
.log { background: #09060f; border-radius: 8px; padding: 10px; font-family: ui-monospace, Consolas, monospace; font-size: .72em; color: #c4b5fd; max-height: 260px; overflow: auto; white-space: pre-wrap; line-height: 1.55; }
.file { font-size: .78em; padding: 4px 0; border-bottom: 1px solid #1f1730; cursor: pointer; color: #d8b4fe; }
.file:hover { color: #fff; }
iframe.studio { width: 100%; min-height: 520px; border: 1px solid var(--border); border-radius: 8px; background: #05040a; }
.hint { background: #1a1030; border: 1px solid #4c1d95; border-radius: 8px; padding: 10px; font-size: .8em; line-height: 1.55; color: #ddd6fe; margin-bottom: 10px; }
</style>
</head>
<body>
<div class="topbar">
  <div class="topbar-left">
    <a class="back" href="/">← 首页</a>
    <h1>Hypit 内置 Agent</h1>
    <span class="tag" id="verTag">HYPIT</span>
  </div>
  <div class="topbar-right">
    <span class="pill" id="engineTag" title="LLM 引擎">GPT-5.6 + Grok-4.6</span>
    <span class="pill" id="prodTag" title="当前工程">未选工程</span>
    <span class="pill" onclick="toggleRight()">侧栏</span>
  </div>
</div>
<div class="layout" id="layout">
  <aside class="sidebar">
    <div class="panel">
      <div class="section">环境</div>
      <div id="envChips"></div>
      <div class="muted" id="envPath" style="margin-top:6px"></div>
      <div class="row" style="margin-top:8px">
        <button class="btn ghost" onclick="loadEnv()">刷新</button>
        <button class="btn ghost" onclick="agentQuick('请运行 hypit doctor 自检环境')">Doctor</button>
        <button class="btn ghost" onclick="agentQuick('请运行 hypit runtime status 查看运行时')">Status</button>
      </div>
    </div>
    <div class="panel">
      <div class="section">参考视频</div>
      <label class="upload">点击或拖入参考片
        <input type="file" accept="video/*" onchange="upload('reference', this)">
      </label>
      <div id="refList"></div>
    </div>
    <div class="panel">
      <div class="section">共享素材</div>
      <label class="upload">人物 / 产品 / Logo
        <input type="file" accept="image/*,video/*,audio/*" onchange="upload('asset', this)">
      </label>
    </div>
    <div class="panel">
      <div class="section">新建工程</div>
      <label>名称</label>
      <input id="prodName" placeholder="例如 product-ranking">
      <label>Brief</label>
      <textarea id="prodBrief" placeholder="目标、要替换的人物/产品、平台与时长…"></textarea>
      <label>关联参考</label>
      <select id="prodRef"><option value="">（可选）</option></select>
      <div class="row" style="margin-top:8px">
        <button class="btn primary" onclick="createProduction()">创建工程</button>
      </div>
      <div id="prodList" style="margin-top:10px"></div>
    </div>
  </aside>

  <main class="chat">
    <div class="chat-head">
      <div>
        <div class="title">导演 Agent · codex+skill 模式</div>
        <div class="sub" id="chatSub">已经加载 hypit skill。说说你想做什么片，agent 会按 skill 跑流程并征求你的批准。</div>
      </div>
      <div class="actions">
        <button class="btn ghost" onclick="newChat()">新对话</button>
      </div>
    </div>
    <div class="messages" id="messages">
      <div class="empty" id="empty">
        <div class="icon">🎬</div>
        <div>和 Agent 说话来开始制作</div>
        <div class="muted" style="margin-top:8px">例如：用上传的参考片做一条 30s 短片</div>
      </div>
    </div>
    <div class="composer">
      <div class="composer-inner">
        <textarea id="input" placeholder="输入需求，Enter 发送，Shift+Enter 换行" onkeydown="onInputKey(event)"></textarea>
        <button class="btn primary send" id="sendBtn" onclick="sendUser()">发送</button>
      </div>
      <div class="hint-row">每次工具调用都会先弹出批准卡片，确认后才会执行</div>
    </div>
  </main>

  <aside class="right-panel" id="rightPanel" style="display:none">
    <span class="close" onclick="toggleRight(true)">×</span>
    <div class="tabs">
      <div class="tab active" data-tab="files" onclick="showRightTab('files')">文件</div>
      <div class="tab" data-tab="studio" onclick="showRightTab('studio')">Studio</div>
      <div class="tab" data-tab="logs" onclick="showRightTab('logs')">日志</div>
    </div>
    <section id="rtab-files">
      <div class="section">工作区文件</div>
      <div id="fileTree"></div>
      <div class="section" style="margin-top:12px">文件内容</div>
      <div class="muted" id="fileName">点击文件打开</div>
      <textarea id="fileEditor" style="min-height:220px; margin-top:6px"></textarea>
      <div class="row" style="margin-top:6px">
        <button class="btn primary" onclick="saveFile()">保存</button>
      </div>
    </section>
    <section id="rtab-studio" style="display:none">
      <div class="section">Hypit Studio</div>
      <div class="row">
        <select id="runSelect" style="flex:1"></select>
        <button class="btn primary" style="flex:0 0 80px" onclick="startStudio()">打开</button>
        <button class="btn ghost" style="flex:0 0 60px" onclick="stopStudio()">停止</button>
      </div>
      <div class="muted" id="studioMeta" style="margin-top:6px">端口 5179，需先有 .svrun</div>
      <div id="studioFrame" style="margin-top:8px"><div class="muted" style="padding:30px;text-align:center">尚未启动 Studio</div></div>
    </section>
    <section id="rtab-logs" style="display:none">
      <div class="section">CLI / Agent 日志</div>
      <div class="log" id="logBox">等待日志…</div>
    </section>
  </aside>
</div>
<script>
const $ = id => document.getElementById(id);
let env = null, projects = null;
let current = { production: "", file: "" };

// ─── Agent 会话状态 ───
let messages = [];          // OpenAI 消息数组（system 不在前端，由后端注入）
let streaming = false;      // agent 正在流式输出
let pendingAssistant = null;// { content, tool_calls:[{id,name,arguments}] } 累积中
let pendingToolCall = null; // { id, name, arguments } 待批准
let turnCount = 0;

// ─── 工具 ───
function log(text) {
  const box = $('logBox');
  const ts = new Date().toLocaleTimeString();
  box.textContent += `\n[${ts}] ${text}`;
  box.scrollTop = box.scrollHeight;
}

async function api(url, opts) {
  const res = await fetch(url, opts);
  const data = await res.json().catch(() => ({}));
  if (!res.ok) throw new Error(data.detail || data.error || res.statusText);
  return data;
}

function chip(ok, name, meta) {
  return `<span class="chip ${ok ? 'ok' : 'down'}"><span>${ok ? '●' : '○'}</span>${name}${meta ? ' · ' + meta : ''}</span>`;
}

function escapeHtml(s) {
  return (s || '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}

function basicMarkdown(text) {
  // 简易 markdown：代码块 / 行内 code / 粗体 / 换行
  const parts = [];
  let i = 0;
  const re = /```(\w*)\n([\s\S]*?)```/g;
  let m;
  let last = 0;
  while ((m = re.exec(text)) !== null) {
    if (m.index > last) parts.push({ t: 'text', v: text.slice(last, m.index) });
    parts.push({ t: 'code', lang: m[1], v: m[2] });
    last = m.index + m[0].length;
  }
  if (last < text.length) parts.push({ t: 'text', v: text.slice(last) });
  return parts.map(p => {
    if (p.t === 'code') return `<pre><code>${escapeHtml(p.v)}</code></pre>`;
    let v = escapeHtml(p.v);
    v = v.replace(/`([^`]+)`/g, '<code>$1</code>');
    v = v.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
    return v;
  }).join('');
}

// ─── 环境加载 ───
async function loadEnv() {
  env = await api('/api/hypit/env');
  const v = env.version || {};
  const vd = v.data || v.output || v;
  $('verTag').textContent = (vd && (vd.version || vd.name)) ? `v${vd.version || vd.name}` : 'HYPIT';
  $('envChips').innerHTML = [
    chip(!!(vd && (vd.version || vd.name)), 'CLI', vd && (vd.version || vd.name) ? `v${vd.version || vd.name}` : 'missing'),
    chip(env.skill && env.skill.installed, 'Skill', env.skill && env.skill.installed ? 'installed' : 'missing'),
    chip(env.runtime && env.runtime.ready, 'Runtime', env.runtime && env.runtime.selected ? env.runtime.selected : 'not selected'),
    chip(env.studio && env.studio.running, 'Studio', env.studio && env.studio.running ? 'running' : 'idle'),
  ].join('');
  $('envPath').textContent = env.workspace || '';
  if (env.studio && env.studio.url) setStudio(env.studio.url);
}

async function loadProjects() {
  projects = await api('/api/hypit/projects');
  const refs = projects.references || [];
  const prods = projects.productions || [];
  $('refList').innerHTML = refs.length ? refs.map(r =>
    `<div class="item" onclick="selectRef('${r.slug}')"><b>${r.slug}</b><div class="meta">${r.title} · ${r.media.length} 媒体</div></div>`
  ).join('') : '<div class="muted">还没有参考片</div>';
  $('prodRef').innerHTML = '<option value="">（可选）</option>' + refs.map(r => `<option value="${r.slug}">${r.slug}</option>`).join('');
  $('prodList').innerHTML = prods.length ? prods.map(p =>
    `<div class="item ${current.production===p.slug?'active':''}" onclick="selectProd('${p.slug}')"><b>${p.slug}</b><div class="meta">${p.title} · ${p.runs.length} run</div></div>`
  ).join('') : '<div class="muted">还没有工程</div>';
  const runs = [...refs, ...prods].flatMap(x => x.runs || []);
  $('runSelect').innerHTML = runs.length ? runs.map(r => `<option value="${r}">${r}</option>`).join('') : '<option value="">没有 .svrun</option>';
  $('fileTree').innerHTML = (projects.tree || []).map(f =>
    `<div class="file" onclick="${f.dir ? '' : `openFile('${f.path}')`}">${f.dir ? '📁' : '📄'} ${f.path}</div>`
  ).join('');
}

async function selectProd(slug) {
  current.production = slug;
  $('prodTag').textContent = slug;
  $('prodTag').title = '当前工程：' + slug;
  await loadProjects();
  try {
    const data = await api('/api/hypit/file?path=' + encodeURIComponent('productions/' + slug + '/BRIEF.md'));
    $('fileEditor').value = data.content || '';
    current.file = 'productions/' + slug + '/BRIEF.md';
    $('fileName').textContent = current.file;
  } catch (e) { $('fileEditor').value = ''; }
}

function selectRef(slug) {
  openFile('references/' + slug + '/ANALYSIS.md');
  toggleRight(false, 'files');
}

async function createProduction() {
  const name = $('prodName').value.trim();
  if (!name) return alert('请填写工程名称');
  const data = await api('/api/hypit/productions', {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ name, brief: $('prodBrief').value, reference_slug: $('prodRef').value })
  });
  log('创建工程 ' + data.path);
  $('prodName').value = '';
  await loadProjects();
  selectProd(data.slug);
}

async function upload(kind, input) {
  if (!input.files[0]) return;
  const fd = new FormData();
  fd.append('kind', kind);
  fd.append('slug', kind === 'production-asset' ? current.production : '');
  fd.append('file', input.files[0]);
  const data = await api('/api/hypit/upload', { method: 'POST', body: fd });
  log('上传 ' + data.path);
  input.value = '';
  await loadProjects();
}

async function saveFile() {
  if (!current.file) return;
  await api('/api/hypit/file', {
    method: 'PUT', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ path: current.file, content: $('fileEditor').value })
  });
  log('已保存 ' + current.file);
}

async function openFile(path) {
  current.file = path;
  const data = await api('/api/hypit/file?path=' + encodeURIComponent(path));
  $('fileName').textContent = path;
  if (data.text) {
    $('fileEditor').value = data.content || '';
  } else {
    $('fileEditor').value = '二进制 / 媒体文件：' + (data.url || path);
  }
  toggleRight(false, 'files');
}

// ─── Studio ───
function setStudio(url) {
  $('studioMeta').textContent = url;
  $('studioFrame').innerHTML = '<iframe class="studio" title="Hypit Studio" src="' + url + '"></iframe>';
}

async function startStudio() {
  const run = $('runSelect').value;
  if (!run) return alert('没有可打开的 .svrun');
  log('启动 Studio ' + run);
  const data = await api('/api/hypit/studio/start', {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ run })
  });
  setStudio(data.url);
  (data.log || []).forEach(log);
  toggleRight(false, 'studio');
}

async function stopStudio() {
  await api('/api/hypit/studio/stop', { method: 'POST' });
  $('studioFrame').innerHTML = '<div class="muted" style="padding:30px;text-align:center">Studio 已停止</div>';
  log('Studio 已停止');
  await loadEnv();
}

// ─── 右侧抽屉 ───
function toggleRight(close, tab) {
  const layout = $('layout');
  const panel = $('rightPanel');
  if (close === true) {
    layout.classList.remove('show-right');
    panel.style.display = 'none';
    return;
  }
  layout.classList.add('show-right');
  panel.style.display = 'block';
  if (tab) showRightTab(tab);
}

function showRightTab(name) {
  document.querySelectorAll('.right-panel .tab').forEach(t => t.classList.toggle('active', t.dataset.tab === name));
  ['files', 'studio', 'logs'].forEach(id => {
    const el = $('rtab-' + id);
    if (el) el.style.display = id === name ? 'block' : 'none';
  });
}

// ─── Agent 聊天 ───
function clearEmpty() {
  const e = $('empty');
  if (e) e.remove();
}

function addMsg(role) {
  clearEmpty();
  const wrap = document.createElement('div');
  wrap.className = 'msg ' + (role === 'user' ? 'user' : 'asst');
  wrap.innerHTML = `<div class="role">${role === 'user' ? '你' : 'Agent'}</div><div class="bubble"></div>`;
  $('messages').appendChild(wrap);
  wrap._bubble = wrap.querySelector('.bubble');
  $('messages').scrollTop = $('messages').scrollHeight;
  return wrap;
}

function addToolCard(name, args, rawArgs, id) {
  clearEmpty();
  const card = document.createElement('div');
  card.className = 'msg';
  card.innerHTML = `
    <div class="tool-card pending" data-id="${id || ''}">
      <div class="head">
        <span class="name">🔧 ${escapeHtml(name)}</span>
        <span class="badge">待批准</span>
      </div>
      <div class="args">${escapeHtml(typeof args === 'string' ? args : JSON.stringify(args, null, 2))}</div>
      <div class="actions">
        <button class="btn ok-btn" onclick="approveTool(this)">批准执行</button>
        <button class="btn no-btn" onclick="rejectTool(this)">拒绝</button>
      </div>
      <div class="result" style="display:none"></div>
    </div>`;
  $('messages').appendChild(card);
  $('messages').scrollTop = $('messages').scrollHeight;
  return card;
}

function setStreamCursor(bubble, on) {
  if (!bubble) return;
  const cur = bubble.querySelector('.streaming-cursor');
  if (on && !cur) {
    const s = document.createElement('span');
    s.className = 'streaming-cursor';
    bubble.appendChild(s);
  } else if (!on && cur) {
    cur.remove();
  }
}

function onInputKey(e) {
  if (e.key === 'Enter' && !e.shiftKey) {
    e.preventDefault();
    sendUser();
  }
}

function sendUser() {
  if (streaming) return;
  const ta = $('input');
  const text = ta.value.trim();
  if (!text) return;
  ta.value = '';
  ta.style.height = 'auto';
  const wrap = addMsg('user');
  wrap._bubble.innerHTML = basicMarkdown(text);
  messages.push({ role: 'user', content: text });
  startAgentTurn();
}

function agentQuick(text) {
  if (streaming) return;
  $('input').value = text;
  sendUser();
}

function newChat() {
  if (streaming) return;
  messages = [];
  pendingAssistant = null;
  pendingToolCall = null;
  $('messages').innerHTML = `<div class="empty" id="empty"><div class="icon">🎬</div><div>和 Agent 说话来开始制作</div><div class="muted" style="margin-top:8px">例如：用上传的参考片做一条 30s 短片</div></div>`;
  $('chatSub').textContent = '已经加载 hypit skill。说说你想做什么片，agent 会按 skill 跑流程并征求你的批准。';
  turnCount = 0;
}

// SSE POST 流式调用
async function streamSSE(url, body, handlers) {
  const res = await fetch(url, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(body),
  });
  if (!res.ok) {
    const txt = await res.text().catch(() => '');
    throw new Error(txt || `HTTP ${res.status}`);
  }
  const reader = res.body.getReader();
  const dec = new TextDecoder('utf-8');
  let buf = '';
  while (true) {
    const { value, done } = await reader.read();
    if (done) break;
    buf += dec.decode(value, { stream: true });
    let idx;
    while ((idx = buf.indexOf('\n\n')) >= 0) {
      const frame = buf.slice(0, idx);
      buf = buf.slice(idx + 2);
      const lines = frame.split('\n');
      let event = 'message';
      const dataLines = [];
      for (const ln of lines) {
        if (ln.startsWith('event: ')) event = ln.slice(7).trim();
        else if (ln.startsWith('data: ')) dataLines.push(ln.slice(6));
      }
      const dataStr = dataLines.join('\n');
      let data;
      try { data = JSON.parse(dataStr); } catch { data = { raw: dataStr }; }
      await handlers.onEvent(event, data);
    }
  }
}

async function startAgentTurn() {
  streaming = true;
  $('sendBtn').disabled = true;
  $('chatSub').textContent = 'Agent 思考中…';
  let bubble = null;
  pendingAssistant = { content: '', tool_calls: [] };
  pendingToolCall = null;
  turnCount += 1;

  try {
    await streamSSE('/api/hypit/agent/chat', {
      messages,
      production: current.production,
    }, {
      onEvent: async (event, data) => {
        if (event === 'delta') {
          if (!bubble) {
            const wrap = addMsg('assistant');
            bubble = wrap._bubble;
          }
          pendingAssistant.content += data.text || '';
          bubble.innerHTML = basicMarkdown(pendingAssistant.content);
          setStreamCursor(bubble, true);
          $('messages').scrollTop = $('messages').scrollHeight;
        } else if (event === 'tool_call_delta') {
          // 累积工具调用片段
          let slot = pendingAssistant.tool_calls.find(t => t.id === data.id);
          if (!slot) { slot = { id: data.id, name: '', arguments: '' }; pendingAssistant.tool_calls.push(slot); }
          if (data.name) slot.name = data.name;
          if (data.arguments !== undefined) slot.arguments = data.arguments;
        } else if (event === 'assistant_message') {
          // 后端给的权威 assistant 消息（含可能的 tool_calls）
          pendingAssistant.content = data.content || pendingAssistant.content;
          pendingAssistant.tool_calls = data.tool_calls || [];
          if (bubble) {
            bubble.innerHTML = basicMarkdown(pendingAssistant.content);
          }
        } else if (event === 'tool_call') {
          // 一次只批准一个
          pendingToolCall = { id: data.id, name: data.name, arguments: data.arguments, raw_arguments: data.raw_arguments };
          setStreamCursor(bubble, false);
          const card = addToolCard(data.name, data.arguments, data.raw_arguments, data.id);
          pendingToolCall.card = card;
          if (bubble) bubble.innerHTML = basicMarkdown(pendingAssistant.content);
        } else if (event === 'done') {
          setStreamCursor(bubble, false);
          if (data.finish_reason) {
            log(`Turn ${turnCount} finish: ${data.finish_reason}${data.needs_approval ? ' (需批准)' : ''}`);
          }
        } else if (event === 'error') {
          setStreamCursor(bubble, false);
          const errMsg = data.message || '未知错误';
          if (bubble) {
            bubble.innerHTML += `<div style="color:var(--err);margin-top:6px">⚠ ${escapeHtml(errMsg)}</div>`;
          } else {
            const wrap = addMsg('assistant');
            wrap._bubble.innerHTML = `<div style="color:var(--err)">⚠ ${escapeHtml(errMsg)}</div>`;
          }
          log('Agent 错误：' + errMsg);
        }
      },
    });
    // 把 assistant 消息写入历史
    if (pendingAssistant && (pendingAssistant.content || pendingAssistant.tool_calls.length)) {
      const msg = { role: 'assistant', content: pendingAssistant.content };
      if (pendingAssistant.tool_calls.length) {
        msg.tool_calls = pendingAssistant.tool_calls.map(tc => ({
          id: tc.id, type: 'function',
          function: { name: tc.name, arguments: tc.arguments },
        }));
      }
      messages.push(msg);
    }
  } catch (e) {
    log('stream error: ' + e.message);
    if (!bubble) {
      const wrap = addMsg('assistant');
      wrap._bubble.innerHTML = `<div style="color:var(--err)">⚠ ${escapeHtml(e.message)}</div>`;
    }
  } finally {
    streaming = false;
    $('sendBtn').disabled = false;
    $('chatSub').textContent = pendingToolCall
      ? '⏸ Agent 提议了一次工具调用，等批准'
      : '可继续输入指令';
  }
}

async function approveTool(btn) {
  if (!pendingToolCall) return;
  const card = pendingToolCall.card;
  card.classList.remove('pending');
  card.classList.add('approved');
  card.querySelector('.badge').textContent = '执行中';
  card.querySelector('.actions').style.display = 'none';
  const resultBox = card.querySelector('.result');
  resultBox.style.display = 'block';
  resultBox.classList.remove('err');
  resultBox.classList.add('ok');
  resultBox.textContent = '执行中…';

  streaming = true;
  $('sendBtn').disabled = true;
  $('chatSub').textContent = 'Agent 执行工具中…';
  let bubble = null;
  pendingAssistant = { content: '', tool_calls: [] };

  try {
    await streamSSE('/api/hypit/agent/execute', {
      messages,
      tool_call_id: pendingToolCall.id,
      name: pendingToolCall.name,
      arguments: pendingToolCall.raw_arguments,
      production: current.production,
    }, {
      onEvent: async (event, data) => {
        if (event === 'tool_result') {
          const ok = data && data.ok;
          resultBox.classList.toggle('ok', !!ok);
          resultBox.classList.toggle('err', !ok);
          const summary = ok
            ? (data.output ? data.output.slice(-1200) : JSON.stringify(data, null, 2).slice(-1200))
            : (data.error || JSON.stringify(data, null, 2).slice(-1200));
          resultBox.textContent = summary;
          card.querySelector('.badge').textContent = ok ? '完成' : '失败';
          log(`工具 ${pendingToolCall.name} 完成 ok=${ok}`);
          // 关键：把 tool 角色消息写进 messages，避免下轮 422
          messages.push({
            role: 'tool',
            tool_call_id: pendingToolCall.id,
            content: typeof summary === 'string' ? summary : JSON.stringify(data),
          });
          // 文件改动后刷新
          if (pendingToolCall.name === 'write_file' || pendingToolCall.name === 'hypit_cli') {
            loadProjects();
          }
          if (pendingToolCall.name === 'studio_start' && ok && data.url) {
            setStudio(data.url);
            toggleRight(false, 'studio');
          }
        } else if (event === 'delta') {
          if (!bubble) {
            const wrap = addMsg('assistant');
            bubble = wrap._bubble;
          }
          pendingAssistant.content += data.text || '';
          bubble.innerHTML = basicMarkdown(pendingAssistant.content);
          setStreamCursor(bubble, true);
          $('messages').scrollTop = $('messages').scrollHeight;
        } else if (event === 'tool_call_delta') {
          let slot = pendingAssistant.tool_calls.find(t => t.id === data.id);
          if (!slot) { slot = { id: data.id, name: '', arguments: '' }; pendingAssistant.tool_calls.push(slot); }
          if (data.name) slot.name = data.name;
          if (data.arguments !== undefined) slot.arguments = data.arguments;
        } else if (event === 'assistant_message') {
          pendingAssistant.content = data.content || pendingAssistant.content;
          pendingAssistant.tool_calls = data.tool_calls || [];
          if (bubble) bubble.innerHTML = basicMarkdown(pendingAssistant.content);
        } else if (event === 'tool_call') {
          setStreamCursor(bubble, false);
          pendingToolCall = { id: data.id, name: data.name, arguments: data.arguments, raw_arguments: data.raw_arguments };
          const newCard = addToolCard(data.name, data.arguments, data.raw_arguments, data.id);
          pendingToolCall.card = newCard;
          if (bubble) bubble.innerHTML = basicMarkdown(pendingAssistant.content);
        } else if (event === 'done') {
          setStreamCursor(bubble, false);
          if (data.finish_reason) log(`Execute 后续 finish: ${data.finish_reason}${data.needs_approval ? ' (需批准)' : ''}`);
        } else if (event === 'error') {
          setStreamCursor(bubble, false);
          const errMsg = data.message || '未知错误';
          if (bubble) bubble.innerHTML += `<div style="color:var(--err);margin-top:6px">⚠ ${escapeHtml(errMsg)}</div>`;
          log('Agent 错误：' + errMsg);
        }
      },
    });
    if (pendingAssistant && (pendingAssistant.content || pendingAssistant.tool_calls.length)) {
      const msg = { role: 'assistant', content: pendingAssistant.content };
      if (pendingAssistant.tool_calls.length) {
        msg.tool_calls = pendingAssistant.tool_calls.map(tc => ({
          id: tc.id, type: 'function',
          function: { name: tc.name, arguments: tc.arguments },
        }));
      }
      messages.push(msg);
    }
  } catch (e) {
    log('execute stream error: ' + e.message);
    resultBox.classList.add('err');
    resultBox.textContent = '⚠ ' + e.message;
    card.querySelector('.badge').textContent = '异常';
  } finally {
    streaming = false;
    $('sendBtn').disabled = false;
    $('chatSub').textContent = pendingToolCall ? '⏸ Agent 提议了新的工具调用，等批准' : '可继续输入指令';
  }
}

function rejectTool(btn) {
  if (!pendingToolCall) return;
  const card = pendingToolCall.card;
  card.classList.remove('pending');
  card.classList.add('rejected');
  card.querySelector('.badge').textContent = '已拒绝';
  card.querySelector('.actions').style.display = 'none';
  const resultBox = card.querySelector('.result');
  resultBox.style.display = 'block';
  resultBox.classList.add('err');
  resultBox.textContent = '用户拒绝执行此工具调用';
  // 关键：先补 tool 角色消息满足 schema，再补 user 角色消息解释拒绝意图
  messages.push({
    role: 'tool',
    tool_call_id: pendingToolCall.id,
    content: '用户拒绝执行此工具调用，请不要重试同一调用。',
  });
  const rejectMsg = `我拒绝执行工具 ${pendingToolCall.name}（参数：${pendingToolCall.raw_arguments || '{}'}）。请重新规划，不要重复这个调用。`;
  messages.push({ role: 'user', content: rejectMsg });
  pendingToolCall = null;
  // 自动开启新一轮
  startAgentTurn();
}

// 自动调整输入框高度
const ta = $('input');
ta.addEventListener('input', () => {
  ta.style.height = 'auto';
  ta.style.height = Math.min(200, ta.scrollHeight) + 'px';
});

loadEnv().then(() => loadProjects()).catch(e => { log(e.message); });
</script>
</body>
</html>
