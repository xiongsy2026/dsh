# ============================================================
# Weeksir 视频管线后端 - 环境变量模板
# 复制为 .env 并填入真实密钥（绝不提交真密钥到 Git）
# ============================================================

# --- 模型 API Keys ---
# 小米 MiMo（分镜/看图）
MIMO_API_KEY=
MIMO_BASE_URL=https://lant.top/relay-api/v1
# 备选：MIMO_VIDEO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
# MIMO_VIDEO_API_KEY=

# OpenAI 兼容层（gpt-5.6-sol 等）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://hub.nocannobb.com/v1
OPENAI_MODEL=gpt-5.6-sol

# GPT 5.5 / 5.6 直连
GPT55_API_KEY=
GPT56_API_KEY=

# Agnes 多模态（看图/生图/生视频）
AGNES_API_KEY=
AGNES_BASE_URL=https://api.agnes-ai.cn/v1

# Grok
SR_GROK_API_KEY=

# XJAI
XJAI_API_KEY=

# 阿里百炼（qwen 等）
DASHSCOPE_API_KEY=

# Image2（生图）
IMAGE2_API_KEY=
IMAGE2_PROXY_URL=

# Vinted.cam 聚合视频 API（Seedance 2.0/2.5）
VINTED_VIDEO_API_BASE=https://vinted.cam
VINTED_VIDEO_API_KEY=

# Replicate
REPLICATE_API_TOKEN=

# Ninfer (qwen3.8-27b)
QN_NINFER_API_KEY=

# 字节音频
BYTEDANCE_AUDIO_API_KEY=

# 有赞（万相 Prime）
YOUZAN_API_KEY=

# --- RunningHub ---
# 统一主 Key
RUNNINGHUB_API_KEY=
# 企业版
RUNNINGHUB_ENTERPRISE_API_KEY=
# H3 专用
RUNNINGHUB_H3_API_KEY=
# Motion / Wan2.2
RUNNINGHUB_MOTION_WAN22_API_KEY=
# Wan3
RUNNINGHUB_WAN3_API_KEY=
# Ideogram 4
RUNNINGHUB_IDEOGRAM4_API_KEY=
# LipSync
RUNNINGHUB_LIPSYNC_API_KEY=

# H3 导演台工作流 ID
RUNNINGHUB_H3_DIRECTOR_WORKFLOW_ID=
RUNNINGHUB_H3_DIRECTOR_REF2VA_WORKFLOW_ID=

# --- 万相 / 天阙 / 满血 / Prime 视频 ---
# api.tianyue.xyz (wan3.0 studio)
TIANYUE_BASE_URL=https://api.tianyue.xyz
TIANYUE_API_KEY=
TIANYUE_WAN30_MODEL=ME-WAN3-prime-1080p-1055
TIANYUE_DURATION_MODE=seconds
TIANYUE_WAN30_FALLBACK_MODEL=
# 代理（直连被 reset 时用）
TIANYUE_PROXY_URL=http://127.0.0.1:7897

# youzan666.vip (wan3.0 Prime - 当前主力)
WAN3_PRIME_YZ_BASE_URL=https://youzan666.vip
WAN3_PRIME_YZ_API_KEY=
WAN3_PRIME_YZ_MODEL=wan3.0-video-prime
YZ30_PROXY_URL=

# 满血 API (manxueapi.com) - H3
MANXUE_H3_API_KEY=

# Motion 产品专用
MOTION_PRODUCT_API_KEY=

# --- 复刻管线配置 ---
# LLM 引擎（分镜/改写）
REPLICA_WAN3_LLM_ENGINE=gpt
REPLICA_WAN3_LINT_ENGINE=
REPLICA_WAN3_LLM_PROXY=http://127.0.0.1:7897

# 看图腿链（按序：qfmodel→opencode mimo→mimo flash）
REPLICA_WAN3_ANALYZE_PURPOSE=magpie_qfmodel:1,magpie_mimo:1,mimo:1

# 分镜腿（唯一吃视频的腿）
REPLICA_WAN3_STORYBOARD_ENGINE=gateway
REPLICA_WAN3_STORYBOARD_MODEL=nemotron-3.5-vl

# --- 网关认证 ---
# 供 hypit_bridge / 8100 等服务端间调用鉴权
MODEL_GATEWAY_TOKEN=

# --- Weeksir 账号（RPA 登录用）---
WEEKSIR_USERNAME=
WEEKSIR_PASSWORD=

# --- 图床 ---
IMGBB_API_KEY=